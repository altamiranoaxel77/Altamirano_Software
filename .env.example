# Gmail SMTP (Nodemailer) — endpoint /api/contact
# GMAIL_USER: cuenta de Gmail que envía los mensajes del formulario.
# GMAIL_APP_PASSWORD: contraseña de aplicación (NO la contraseña normal
#   de la cuenta). Se genera en la configuración de seguridad de Google
#   con verificación en 2 pasos activada.
# Gestión de esta credencial: usuario humano de la empresa (EMP-10).
# Nunca commitear el archivo .env real al repositorio.
GMAIL_USER=
GMAIL_APP_PASSWORD=

# Opcional: casilla que recibe los mensajes del formulario.
# Si se omite, se usa GMAIL_USER como destino.
CONTACT_DESTINATION_EMAIL=
